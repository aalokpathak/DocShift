{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocShift",
  "version": "2.0.0",
  "identifier": "com.aalokpathak.docshift",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DocShift",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#f5f6f8",
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Convert, compress and edit PDFs, Office documents, images and video",
    "longDescription": "DocShift converts Word, Excel, PowerPoint and images to PDF and back, compresses PDFs, images and video to an exact size, and merges, splits and edits PDF pages.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "DocShift",
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "publisher": "Alok Pathak",
    "category": "Productivity",
    "copyright": "Copyright (c) Alok Pathak"
  }
}
